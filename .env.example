# Clerk
CLERK_SECRET_KEY=
VITE_API_URL=http://localhost:3000
CLERK_PUBLISHABLE_KEY=

# Runs the Solid Queue workers inside Puma (config/puma.rb). Set it on Render too.
SOLID_QUEUE_IN_PUMA=1

# morpheus-agent: http://localhost:8001 locally (uv run uvicorn main:app --port 8001); on Render, the agent's internal
# address from its Connect menu. The token is the agent's AGENT_TOKEN.
AGENT_URL=http://localhost:8001
AGENT_TOKEN=
